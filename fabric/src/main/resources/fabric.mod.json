{
    "schemaVersion": 1,
    "id": "repairstation",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "sources": "https://github.com/putzwirk/repair-station"
    },
    "license": "${license}",
    "icon": "assets/repairstation/icon.png",
    "environment": "*",
    "accessWidener": "repairstation.accesswidener",
    "entrypoints": {
        "main": [
            "com.neuromuser.repairstation.RepairStationFabric"
        ],
        "client": [
            "com.neuromuser.repairstation.RepairStationFabricClient"
        ],
        "modmenu": [
            "com.neuromuser.repairstation.compat.ModMenuIntegration"
        ],
        "fabric-gametest": [
            "com.neuromuser.repairstation.RepairStationFabricGameTest"
        ]
    },
    "depends": {
        "fabricloader": ">=0.16.9",
        "fabric-api": "*",
        "minecraft": "1.21.11",
        "java": ">=21"
    },
    "suggests": {
        "modmenu": "*"
    }
}
